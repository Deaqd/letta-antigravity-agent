# Letta Integration Configuration

# Mode selection: 'auto', 'remote', or 'embedded'
# 'auto': uses remote Letta if LETTA_API_KEY or LETTA_BASE_URL is reachable, else embedded
LETTA_MODE=auto

# Remote Letta Server / Letta Cloud settings
# If using Letta Cloud: https://api.letta.com
# If using self-hosted Letta server: http://localhost:8283
LETTA_BASE_URL=http://localhost:8283
LETTA_API_KEY=

# Google Gemini API Key (used for embedded agent execution and embeddings)
# Can also be picked up from GEMINI_API_KEY or GOOGLE_API_KEY environment variables
GEMINI_API_KEY=

# Default Gemini model for the embedded Letta agent
# Recommended: gemini-2.5-flash or gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Embedded database path (SQLite)
LETTA_STORAGE_PATH=./data/letta_storage.db

# Default Active Agent Name/ID
LETTA_DEFAULT_AGENT=Antigravity-Letta-Partner
